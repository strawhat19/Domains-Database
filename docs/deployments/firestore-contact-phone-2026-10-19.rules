rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function identityPath() { return /databases/$(database)/documents/identities/$(request.auth.uid); }
    function userPath(userId) { return /databases/$(database)/documents/users/$(userId); }
    function counterPath() { return /databases/$(database)/documents/counters/users; }
    function submissionCounterPath() { return /databases/$(database)/documents/counters/formSubmissions; }
    function submissionPath(submissionId) { return /databases/$(database)/documents/formSubmissions/$(submissionId); }
    function ownsAccount(userId) {
      return signedIn() && exists(identityPath()) && get(identityPath()).data.id == userId
        && get(userPath(userId)).data.firebase_uid == request.auth.uid && get(userPath(userId)).data.active == true;
    }
    function isOwner() {
      return signedIn() && exists(identityPath()) && ownsAccount(get(identityPath()).data.id)
        && get(userPath(get(identityPath()).data.id)).data.role == 'Owner';
    }
    function recordIdentity(recordId, recordType) {
      return request.resource.data.id == recordId && request.resource.data.number is int
        && request.resource.data.number > 0 && recordId.matches(recordType + '_' + string(request.resource.data.number) + '_.*');
    }
    function newIdentity() {
      return signedIn() && !exists(identityPath()) && getAfter(identityPath()).data.firebase_uid == request.auth.uid
        && getAfter(identityPath()).data.number == getAfter(counterPath()).data.number
        && getAfter(counterPath()).data.number == (exists(counterPath()) ? get(counterPath()).data.number + 1 : 1);
    }
    function profileValues() {
      return request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 100
        && request.resource.data.description is string && request.resource.data.description.size() <= 2000
        && request.resource.data.profilePrivacy in ['public', 'private'] && request.resource.data.publicDomains is bool
        && request.resource.data.verified == request.auth.token.email_verified
        && request.resource.data.emailVerified == request.auth.token.email_verified;
    }
    function submissionValues() {
      return request.resource.data.keys().hasAll(['id', 'uid', 'form', 'name', 'type', 'email', 'number', 'status', 'subject', 'message', 'created', 'updated'])
        && request.resource.data.keys().hasOnly(['id', 'uid', 'form', 'name', 'type', 'email', 'phone', 'number', 'status', 'subject', 'message', 'created', 'updated'])
        && request.resource.data.form == 'contact' && request.resource.data.type == 'FormSubmission'
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 100
        && request.resource.data.email is string && request.resource.data.email.size() > 0 && request.resource.data.email.size() <= 254
        && request.resource.data.email.matches('^[^\\s@]+@[^\\s@]+[.][^\\s@]+$')
        && request.resource.data.get('phone', '') is string && request.resource.data.get('phone', '').size() <= 40
        && request.resource.data.subject is string && request.resource.data.subject.size() > 0 && request.resource.data.subject.size() <= 200
        && request.resource.data.message is string && request.resource.data.message.size() > 0 && request.resource.data.message.size() <= 5000
        && request.resource.data.status == 'new' && request.resource.data.uid == (signedIn() ? request.auth.uid : '')
        && request.resource.data.created == request.time && request.resource.data.updated == request.time;
    }
    function newSubmissionCounter() {
      let data = request.resource.data;
      return data.keys().hasAll(['number', 'lastSubmissionId']) && data.keys().hasOnly(['number', 'lastSubmissionId'])
        && data.number is int && data.number > 0 && data.lastSubmissionId is string && data.lastSubmissionId.size() < 200
        && data.number == (exists(submissionCounterPath()) ? get(submissionCounterPath()).data.number + 1 : 1)
        && !exists(submissionPath(data.lastSubmissionId))
        && getAfter(submissionPath(data.lastSubmissionId)).data.id == data.lastSubmissionId
        && getAfter(submissionPath(data.lastSubmissionId)).data.number == data.number;
    }
    function planPath(planId) { return /databases/$(database)/documents/plans/$(planId); }
    function actorId() { return get(identityPath()).data.id; }
    function planSlugPath(slug) { return /databases/$(database)/documents/planSlugs/$(slug); }
    function planTierValues(data, slug) {
      return data is map && data.keys().hasAll(['id', 'slug', 'number', 'displayOrder']) && data.keys().hasOnly(['id', 'slug', 'number', 'displayOrder'])
        && data.slug == slug && slug is string && slug.size() > 0 && slug.size() <= 100 && slug.matches('^[a-z0-9]+(-[a-z0-9]+)*$')
        && data.number is int && data.number > 0 && data.number <= 9007199254740991
        && data.displayOrder is int && data.displayOrder >= 0 && data.displayOrder <= 9007199254740991
        && data.id is string && data.id.size() <= 240
        && data.id.matches('Plan_' + string(data.number) + '_.+_[0-9]{1,2}_[0-9]{2}_(AM|PM)_[0-9]{2}_[0-9]{2}_[0-9]{2}_[A-Za-z0-9-]+');
    }
    function livePlanTier(slug) {
      return slug is string && slug.size() <= 100 && slug.matches('^[a-z0-9]+(-[a-z0-9]+)*$') && exists(planSlugPath(slug))
        && planTierValues(get(planSlugPath(slug)).data, slug) && exists(planPath(get(planSlugPath(slug)).data.id))
        && get(planPath(get(planSlugPath(slug)).data.id)).data.id == get(planSlugPath(slug)).data.id
        && get(planPath(get(planSlugPath(slug)).data.id)).data.type == 'Plan'
        && get(planPath(get(planSlugPath(slug)).data.id)).data.slug == slug
        && get(planPath(get(planSlugPath(slug)).data.id)).data.number == get(planSlugPath(slug)).data.number
        && get(planPath(get(planSlugPath(slug)).data.id)).data.displayOrder == get(planSlugPath(slug)).data.displayOrder;
    }
    function planTierAtLeast(plan, minimum) {
      let viewer = get(planPath(get(planSlugPath(plan)).data.id)).data;
      let selected = get(planPath(get(planSlugPath(minimum)).data.id)).data;
      return viewer.displayOrder > selected.displayOrder || (viewer.displayOrder == selected.displayOrder && viewer.number >= selected.number);
    }
    function featureSettingsId() { return 'FeatureSettings_1_Global_12_00_AM_10_12_26_cb23b14255924fdd95957eac7ca7e35e'; }
    function featureSettingsPath() { return /databases/$(database)/documents/featureSettings/$(featureSettingsId()); }
    function featureAudienceAllows(data, key, role, plan) {
      let audience = data.get('audiences', {}).get(key, {'roles': null, 'plans': null});
      return (audience.roles == null || role in audience.roles)
        && (audience.get('planMode', '') == 'minimum' ? featureMinimumPlanAllows(audience.plans, plan) : audience.plans == null || plan in audience.plans);
    }
    function featureMinimumPlanAllows(plans, plan) {
      return plan is string && plan.size() <= 100 && plan.matches('^[a-z0-9]+(-[a-z0-9]+)*$')
        && (plans == null || plans.size() == 0 || plans[0] == 'free'
          || (plan != 'free' && livePlanTier(plan) && livePlanTier(plans[0]) && planTierAtLeast(plan, plans[0])));
    }
    function isAccountAdmin() {
      return signedIn() && exists(identityPath()) && ownsAccount(actorId())
        && get(userPath(actorId())).data.role in ['Owner', 'Admin', 'Administrator'];
    }
    function planInterestPath(interestId) { return /databases/$(database)/documents/planInterestRecords/$(interestId); }
    function planInterestCounterPath() { return /databases/$(database)/documents/counters/planInterest; }
    function planInterestSummaryPath(planId) { return /databases/$(database)/documents/planInterestSummary/$(planId); }
    function planInterestLookupPath(firebaseUid, planId) { return /databases/$(database)/documents/planInterestLookup/$(firebaseUid)/plans/$(planId); }
    function anonymousPlanVoter() {
      return signedIn() && request.auth.token.get('firebase', {}).get('sign_in_provider', '') == 'anonymous';
    }
    function planInterestActor() {
      return signedIn() && (anonymousPlanVoter() || (exists(identityPath()) && ownsAccount(actorId())));
    }
    function planInterestUserId() { return anonymousPlanVoter() ? '' : actorId(); }
    function planInterestPricingEnabled() {
      return !exists(featureSettingsPath()) || (get(featureSettingsPath()).data.flags.get('pricingTable', true) == true
        && featureAudienceAllows(get(featureSettingsPath()).data, 'pricingTable', anonymousPlanVoter() ? 'Guest' : get(userPath(actorId())).data.role,
          anonymousPlanVoter() ? 'free' : get(userPath(actorId())).data.get('plan', 'free').lower()));
    }
    function planInterestIdentity(data, interestId) {
      return data.id == interestId && data.type == 'PlanInterest'
        && data.number is int && data.number > 0 && data.number <= 9007199254740991
        && interestId is string && interestId.size() <= 240
        && interestId.matches('PlanInterest_' + string(data.number) + '_Plan_[0-9]{1,2}_[0-9]{2}_(AM|PM)_[0-9]{2}_[0-9]{2}_[0-9]{2}_[A-Za-z0-9-]+');
    }
    function planInterestValues(data, interestId) {
      return data.keys().hasAll(['id', 'type', 'number', 'planId', 'vote', 'userId', 'actorKey', 'migratedTo', 'interested', 'created', 'updated'])
        && data.keys().hasOnly(['id', 'type', 'number', 'planId', 'vote', 'userId', 'actorKey', 'migratedTo', 'interested', 'created', 'updated'])
        && planInterestIdentity(data, interestId) && data.planId is string && data.planId.size() > 0 && data.planId.size() <= 240
        && data.vote in ['up', 'none'] && data.actorKey == request.auth.uid
        && data.userId == planInterestUserId() && data.migratedTo == '' && data.interested is bool
        && (!anonymousPlanVoter() || data.interested == false) && data.created is timestamp && data.updated == request.time;
    }
    function planInterestSummaryCoupled(data) {
      let summary = getAfter(planInterestSummaryPath(data.planId)).data;
      return summary.lastInterestId == data.id && summary.updated == request.time;
    }
    function newPlanInterest(interestId) {
      let data = request.resource.data;
      let lookup = getAfter(planInterestLookupPath(request.auth.uid, data.planId)).data;
      let counter = getAfter(planInterestCounterPath()).data;
      return planInterestActor() && planInterestValues(data, interestId) && data.created == request.time
        && (data.vote != 'none' || data.interested == true)
        && lookup.id == interestId && lookup.number == data.number
        && counter.lastInterestId == interestId && counter.number == data.number
        && data.number == (exists(planInterestCounterPath()) ? get(planInterestCounterPath()).data.number + 1 : 1)
        && planInterestSummaryCoupled(data);
    }
    function updatedPlanInterest(interestId) {
      let data = request.resource.data;
      return planInterestActor() && planInterestValues(data, interestId)
        && data.id == resource.data.id && data.number == resource.data.number && data.type == resource.data.type
        && data.actorKey == resource.data.actorKey && data.userId == resource.data.userId && data.planId == resource.data.planId
        && data.created == resource.data.created && (!resource.data.interested || data.interested)
        && data.updated - resource.data.updated >= duration.value(500, 'ms')
        && data.diff(resource.data).affectedKeys().hasOnly(['vote', 'interested', 'updated'])
        && (data.vote != resource.data.vote || data.interested != resource.data.interested)
        && planInterestSummaryCoupled(data);
    }
    function planInterestCount(value) { return value is int && value >= 0 && value <= 9007199254740991; }
    function planInterestVoteCount(vote, direction) { return vote == direction ? 1 : 0; }
    function planInterestSummaryValues(planId) {
      let data = request.resource.data;
      let plan = get(planPath(planId)).data;
      return data.keys().hasAll(['planId', 'planName', 'up', 'down', 'interested', 'updated', 'lastInterestId'])
        && data.keys().hasOnly(['planId', 'planName', 'up', 'down', 'interested', 'updated', 'lastInterestId'])
        && data.planId == planId && data.planName == plan.name && plan.active == true && plan.id == planId && plan.type == 'Plan'
        && plan.number is int && plan.number > 0 && planId.size() <= 240
        && planId.matches('Plan_' + string(plan.number) + '_.+_[0-9]{1,2}_[0-9]{2}_(AM|PM)_[0-9]{2}_[0-9]{2}_[0-9]{2}_[A-Za-z0-9-]+')
        && planInterestCount(data.up) && planInterestCount(data.down) && planInterestCount(data.interested)
        && data.lastInterestId is string && data.lastInterestId.size() <= 240 && data.updated == request.time;
    }
    function planInterestSummaryChange(planId, previous) {
      let data = request.resource.data;
      let after = getAfter(planInterestPath(data.lastInterestId)).data;
      let before = exists(planInterestPath(data.lastInterestId)) ? get(planInterestPath(data.lastInterestId)).data : {'vote': 'none', 'interested': false};
      return planInterestActor() && planInterestValues(after, data.lastInterestId) && after.planId == planId
        && (!exists(planInterestPath(data.lastInterestId)) || before.updated != request.time)
        && (!planInterestPricingEnabled() || (exists(planInterestPath(data.lastInterestId))
          && before.vote != 'none' && after.vote == 'none' && after.interested == before.interested))
        && data.up == previous.get('up', 0) + planInterestVoteCount(after.vote, 'up') - planInterestVoteCount(before.vote, 'up')
        && data.down == previous.get('down', 0) + planInterestVoteCount(after.vote, 'down') - planInterestVoteCount(before.vote, 'down')
        && data.interested == previous.get('interested', 0) + (after.interested ? 1 : 0) - (before.interested ? 1 : 0);
    }
    function newPlanInterestCounter() {
      let data = request.resource.data;
      let interest = getAfter(planInterestPath(data.lastInterestId)).data;
      let lookup = getAfter(planInterestLookupPath(request.auth.uid, interest.planId)).data;
      return planInterestActor() && data.keys().hasAll(['number', 'lastInterestId']) && data.keys().hasOnly(['number', 'lastInterestId'])
        && data.number is int && data.number > 0 && data.number <= 9007199254740991
        && planInterestIdentity(interest, data.lastInterestId) && interest.number == data.number && interest.actorKey == request.auth.uid
        && interest.created == request.time && !exists(planInterestPath(data.lastInterestId))
        && lookup.id == data.lastInterestId && lookup.number == data.number;
    }
    function newPlanInterestLookup(firebaseUid, planId) {
      let data = request.resource.data;
      let interest = getAfter(planInterestPath(data.id)).data;
      let counter = getAfter(planInterestCounterPath()).data;
      return planInterestActor() && firebaseUid == request.auth.uid
        && data.keys().hasAll(['id', 'number']) && data.keys().hasOnly(['id', 'number'])
        && planInterestIdentity(interest, data.id) && interest.number == data.number && interest.planId == planId
        && interest.actorKey == firebaseUid && interest.created == request.time && !exists(planInterestPath(data.id))
        && counter.lastInterestId == data.id && counter.number == data.number;
    }
    match /identities/{firebaseUid} {
      allow get: if signedIn() && firebaseUid == request.auth.uid;
      allow create: if firebaseUid == request.auth.uid && newIdentity()
        && request.resource.data.keys().hasOnly(['id', 'number', 'firebase_uid'])
        && getAfter(userPath(request.resource.data.id)).data.firebase_uid == firebaseUid
        && getAfter(userPath(request.resource.data.id)).data.number == request.resource.data.number;
    }
    match /counters/users {
      allow get: if signedIn();
      allow create: if newIdentity() && request.resource.data.keys().hasOnly(['number']) && request.resource.data.number == 1;
      allow update: if newIdentity() && request.resource.data.keys().hasOnly(['number'])
        && request.resource.data.number is int && request.resource.data.number == resource.data.number + 1;
    }
    match /counters/formSubmissions {
      allow get: if true;
      allow create, update: if newSubmissionCounter();
    }
    match /formSubmissions/{submissionId} {
      allow read: if isOwner();
      allow create: if submissionValues() && recordIdentity(submissionId, 'FormSubmission')
        && submissionId.matches('FormSubmission_' + string(request.resource.data.number) + '_Contact_[0-9]{1,2}_[0-9]{2}_(AM|PM)_[0-9]{2}_[0-9]{2}_[0-9]{2}_[A-Za-z0-9-]+')
        && getAfter(submissionCounterPath()).data.lastSubmissionId == submissionId
        && getAfter(submissionCounterPath()).data.number == request.resource.data.number
        && getAfter(submissionCounterPath()).data.number == (exists(submissionCounterPath()) ? get(submissionCounterPath()).data.number + 1 : 1);
      allow update: if isOwner() && request.resource.data.status in ['new', 'read', 'archived']
        && request.resource.data.updated == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updated']);
    }
    match /users/{userId} {
      allow get: if signedIn() && resource.data.firebase_uid == request.auth.uid;
      allow create: if newIdentity() && recordIdentity(userId, 'User') && profileValues()
        && request.resource.data.type == 'User' && request.resource.data.uid == request.auth.uid
        && request.resource.data.firebase_uid == request.auth.uid && request.resource.data.number == getAfter(counterPath()).data.number
        && getAfter(identityPath()).data.id == userId && request.resource.data.active == true
        && request.resource.data.role == 'Subscriber' && request.resource.data.roles == ['Subscriber']
        && request.resource.data.plan == 'free' && request.resource.data.profilePrivacy == 'private'
        && request.resource.data.publicDomains == false && request.resource.data.email == request.auth.token.email;
      allow update: if ownsAccount(userId) && profileValues()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name', 'updated', 'verified', 'displayName', 'description', 'lastSignIn', 'lastUpdated',
          'publicDomains', 'emailVerified', 'profilePrivacy', 'lastSignInTime'
        ]);
      match /domains/{recordId} {
        allow read, delete: if ownsAccount(userId);
        allow create, update: if ownsAccount(userId) && recordIdentity(recordId, 'Domain') && request.resource.data.uid == userId;
      }
      match /connections/{recordId} {
        allow read, delete: if ownsAccount(userId);
        allow create, update: if ownsAccount(userId) && recordIdentity(recordId, 'Connection')
          && request.resource.data.keys().hasOnly(['id', 'number', 'provider', 'values'])
          && request.resource.data.values is string
          && request.resource.data.provider in ['vercel', 'godaddy', 'hostinger', 'namecheap', 'porkbun', 'namesilo', 'squarespace'];
      }
      match /auctionInventory/{recordId} {
        allow read, delete: if ownsAccount(userId);
        allow create, update: if ownsAccount(userId) && recordIdentity(recordId, 'Auction');
      }
      match /data/{recordId} {
        allow read, delete: if ownsAccount(userId);
        allow create, update: if ownsAccount(userId) && recordIdentity(recordId, 'Data') && request.resource.data.uid == userId
          && request.resource.data.key is string && request.resource.data.value is string
          && request.resource.data.revision is int && request.resource.data.revision > 0;
      }
      match /storageKeys/{keyId} {
        allow read, delete: if ownsAccount(userId);
        allow create, update: if ownsAccount(userId) && request.resource.data.keys().hasOnly(['id', 'key', 'number'])
          && request.resource.data.id is string && request.resource.data.key is string
          && request.resource.data.number is int && request.resource.data.number > 0;
      }
      match /snapshots/{snapshotId} {
        allow read, delete: if ownsAccount(userId);
        allow create, update: if ownsAccount(userId) && snapshotId in ['storage', 'portfolio', 'connections', 'auctionInventory'];
      }
    }
    match /featureSettings/{settingsId} {
      allow get: if settingsId == featureSettingsId();
    }
    match /plans/{planId} {
      allow get: if resource.data.active == true;
      allow list: if request.query.limit != null && request.query.limit > 0 && request.query.limit <= 101 && resource.data.active == true;
    }
    match /planSlugs/{slug} {
      allow get: if true;
      allow list: if request.query.limit != null && request.query.limit > 0 && request.query.limit <= 201;
    }
    match /counters/planInterest {
      allow get: if planInterestActor();
      allow create: if newPlanInterestCounter() && request.resource.data.number == 1;
      allow update: if newPlanInterestCounter() && request.resource.data.number == resource.data.number + 1;
    }
    match /planInterestSummary/{planId} {
      allow get: if isAccountAdmin();
      allow list: if isAccountAdmin() && request.query.limit != null && request.query.limit > 0 && request.query.limit <= 201;
      allow create: if planInterestSummaryValues(planId) && !exists(planInterestPath(request.resource.data.lastInterestId))
        && planInterestSummaryChange(planId, {});
      allow update: if planInterestSummaryValues(planId) && planInterestSummaryChange(planId, resource.data);
    }
    match /planInterestRecords/{interestId} {
      allow get: if isOwner() || (planInterestActor() && resource.data.actorKey == request.auth.uid);
      allow list: if isOwner() && request.query.limit != null && request.query.limit > 0 && request.query.limit <= 101;
      allow create: if newPlanInterest(interestId);
      allow update: if updatedPlanInterest(interestId);
    }
    match /planInterestLookup/{firebaseUid}/plans/{planId} {
      allow get: if planInterestActor() && firebaseUid == request.auth.uid;
      allow create: if newPlanInterestLookup(firebaseUid, planId);
    }
    match /planInterestLookup/{lookupId} { allow read, write: if false; }
    match /planInterestLimits/{actorId} { allow read, write: if false; }
    match /counters/{counterId}/{document=**} {
      allow read, write: if isOwner() && counterId != 'planInterest';
    }
    match /{path=**}/domains/{recordId} {
      allow list: if isOwner() && request.query.limit != null && request.query.limit > 0 && request.query.limit <= 501;
    }
    match /{collection}/{document=**} {
      allow read, write: if isOwner() && !(collection in ['counters', 'planInterestRecords', 'planInterestLookup', 'planInterestSummary', 'planInterestLimits']);
    }
  }
}
