{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "types": [
      "node",
      "react"
    ],
    "lib": [
      "ESNext",
      "DOM"
    ],
    "moduleSuffixes": [
      "",
      ".web",
      ".native"
    ]
  },
  "include": [
    "**/*.ts",
    "**/*.tsx"
  ]
}
