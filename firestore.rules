      }
      match /likes/{likeId} {
        allow get: if ownsAccount(resource.data.actorId) && socialReadablePostId(postId);
        allow create: if socialActor() && socialRecordIdentity(likeId, 'PostLike')
          && get(socialPostPath(postId)).data.authorId != actorId()
          && request.resource.data.keys().hasAll(['id', 'type', 'number', 'postId', 'actorId', 'created'])
          && request.resource.data.keys().hasOnly(['id', 'type', 'number', 'postId', 'actorId', 'created'])
          && request.resource.data.type == 'PostLike' && request.resource.data.actorId == actorId() && request.resource.data.postId == postId
          && request.resource.data.created == request.time && getAfter(socialLikeActorPath(postId, actorId())).data.id == likeId
          && newSocialNumber('communityLikes', likeId, request.resource.data.number) && postEngagement(postId, 'like-add', likeId);
        allow delete: if socialActor() && ownsAccount(resource.data.actorId) && !existsAfter(socialLikeActorPath(postId, resource.data.actorId)) && postEngagement(postId, 'like-remove', likeId);
      }
      match /comments/{commentId} {
        allow get: if socialReadablePostId(postId) && (ownsAccount(resource.data.authorId) || socialPublicAuthor(resource.data.authorId));
        allow list: if request.query.limit != null && request.query.limit > 0 && request.query.limit <= 11
          && socialReadablePostId(postId) && (ownsAccount(resource.data.authorId) || socialPublicAuthor(resource.data.authorId));
        allow create: if socialActor() && socialPublicAuthor(actorId()) && socialRecordIdentity(commentId, 'PostComment')
          && request.resource.data.keys().hasAll(['id', 'type', 'number', 'body', 'postId', 'authorId', 'created', 'updated'])
          && request.resource.data.keys().hasOnly(['id', 'type', 'number', 'body', 'postId', 'authorId', 'created', 'updated'])
          && request.resource.data.type == 'PostComment' && request.resource.data.authorId == actorId() && request.resource.data.postId == postId
          && request.resource.data.body is string && request.resource.data.body.size() > 0 && request.resource.data.body.size() <= 1000
          && request.resource.data.created == request.time && request.resource.data.updated == request.time
          && newSocialNumber('communityComments', commentId, request.resource.data.number) && postEngagement(postId, 'comment-add', commentId);
        allow delete: if socialActor() && ownsAccount(resource.data.authorId) && socialReadablePostId(postId) && postEngagement(postId, 'comment-remove', commentId);
      }
    }
    match /communityFollows/{followId} {
      allow get: if socialActor() && ownsAccount(resource.data.followerId);
      allow create: if socialActor() && socialRecordIdentity(followId, 'Follow')
        && request.resource.data.keys().hasAll(['id', 'type', 'number', 'followerId', 'followingId', 'created'])
        && request.resource.data.keys().hasOnly(['id', 'type', 'number', 'followerId', 'followingId', 'created'])
        && request.resource.data.type == 'Follow' && request.resource.data.followerId == actorId() && request.resource.data.followingId != actorId()
        && socialPublicAuthor(request.resource.data.followingId) && request.resource.data.created == request.time
        && !exists(socialFollowingPath(actorId(), request.resource.data.followingId))
        && getAfter(socialFollowingPath(actorId(), request.resource.data.followingId)).data.id == followId
        && newSocialNumber('communityFollows', followId, request.resource.data.number);
      allow delete: if ownsAccount(resource.data.followerId) && !existsAfter(socialFollowingPath(resource.data.followerId, resource.data.followingId));
    }
    match /identities/{firebaseUid} {
      allow get: if signedIn() && firebaseUid == request.auth.uid;
      allow create: if firebaseUid == request.auth.uid && newIdentity()
        && request.resource.data.keys().hasOnly(['id', 'number', 'firebase_uid'])
        && getAfter(userPath(request.resource.data.id)).data.firebase_uid == firebaseUid
        && getAfter(userPath(request.resource.data.id)).data.number == request.resource.data.number;
    }
    match /counters/users {
      allow get: if signedIn();
      allow create: if newIdentity() && request.resource.data.keys().hasOnly(['number']) && request.resource.data.number == 1;
      allow update: if newIdentity() && request.resource.data.keys().hasOnly(['number'])
        && request.resource.data.number is int && request.resource.data.number == resource.data.number + 1;
    }
    match /counters/formSubmissions {
      allow get: if true;
      allow create, update: if featureEnabled('contact') && newSubmissionCounter();
    }
    match /counters/features {
      allow get: if isOwner();
      allow create: if isOwner() && request.resource.data.keys().hasAll(['number', 'lastFeatureId'])
        && request.resource.data.keys().hasOnly(['number', 'lastFeatureId']) && request.resource.data.number is int && request.resource.data.number == 1
        && request.resource.data.lastFeatureId == featureSettingsId() && !exists(featureSettingsPath())
        && getAfter(featureSettingsPath()).data.id == featureSettingsId() && getAfter(featureSettingsPath()).data.number == 1;
    }
    match /featureSettings/{settingsId} {
      allow get: if settingsId == featureSettingsId();
      allow create: if isOwner() && settingsId == featureSettingsId() && featureSettingsValues()
        && recordIdentity(settingsId, 'FeatureSettings') && request.resource.data.created == request.time
        && !exists(featureCounterPath()) && getAfter(featureCounterPath()).data.number == 1
        && getAfter(featureCounterPath()).data.lastFeatureId == settingsId;
      allow update: if isOwner() && settingsId == featureSettingsId() && featureSettingsValues()
        && request.resource.data.created == resource.data.created
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['flags', 'audiences', 'updated']);
    }
    match /counters/notifications {
      allow get: if isAccountAdmin();
      allow create, update: if newNotificationCounter();
    }
    match /counters/plans {
      allow get: if isOwner();
      allow create, update: if newPlanCounter();
    }
    match /counters/planInterest {
      allow get: if planInterestActor();
      allow create: if newPlanInterestCounter() && request.resource.data.number == 1;
      allow update: if newPlanInterestCounter() && request.resource.data.number == resource.data.number + 1;
    }
    match /counters/events {
      allow get: if isAccountAdmin();
      allow create, update: if newEventCounter();
    }
    match /counters/adminAudits {
      allow get: if isAccountAdmin();
      allow create, update: if newAuditCounter();
    }
    match /adminAudits/{auditId} {
      allow read: if isOwner();
      allow create: if isAccountAdmin() && recordIdentity(auditId, 'AdminAudit')
        && request.resource.data.keys().hasAll(['id', 'number', 'type', 'action', 'created', 'actorId', 'targetId', 'afterRole', 'beforeRole', 'afterActive', 'beforeActive', 'actorFirebaseUid'])
        && request.resource.data.keys().hasOnly(['id', 'number', 'type', 'action', 'created', 'actorId', 'targetId', 'afterRole', 'beforeRole', 'afterActive', 'beforeActive', 'actorFirebaseUid'])
        && request.resource.data.type == 'AdminAudit' && request.resource.data.action == 'user_access'
        && request.resource.data.created == request.time && request.resource.data.actorId == actorId()
        && request.resource.data.actorFirebaseUid == request.auth.uid && request.resource.data.targetId != actorId()
        && request.resource.data.beforeRole == get(userPath(request.resource.data.targetId)).data.role
        && request.resource.data.beforeActive == get(userPath(request.resource.data.targetId)).data.active
        && request.resource.data.afterRole == getAfter(userPath(request.resource.data.targetId)).data.role
        && request.resource.data.afterActive == getAfter(userPath(request.resource.data.targetId)).data.active
        && getAfter(userPath(request.resource.data.targetId)).data.adminLastAuditId == auditId
        && getAfter(auditCounterPath()).data.lastAuditId == auditId
        && getAfter(auditCounterPath()).data.number == request.resource.data.number
        && (isOwner() || (request.resource.data.beforeRole == request.resource.data.afterRole
          && !(request.resource.data.beforeRole in ['Owner', 'Admin', 'Administrator', 'Developer'])));
    }
    match /notifications/{notificationId} {
      allow get: if isAccountAdmin() || (featureEnabled('notifications') && resource.data.active == true);
      allow list: if request.query.limit != null && request.query.limit <= 101 && (isAccountAdmin() || (featureEnabled('notifications') && resource.data.active == true));
      allow create: if isAccountAdmin() && notificationValues() && newNumberedNotification(notificationId)
        && request.resource.data.created == request.time && notificationMetadata(request.resource.data.metadata);
      allow update: if isAccountAdmin() && notificationValues() && recordIdentity(notificationId, 'Notification')
        && request.resource.data.id == resource.data.id && request.resource.data.uid == resource.data.uid
        && request.resource.data.number == resource.data.number && request.resource.data.type == resource.data.type
        && request.resource.data.uuid == resource.data.uuid && request.resource.data.created == resource.data.get('created', resource.data.get('created_at', ''))
        && request.resource.data.get('providerId', '') == resource.data.get('providerId', '')
        && (request.resource.data.metadata == resource.data.get('metadata', {}) || notificationMetadata(request.resource.data.metadata));
      allow delete: if isAccountAdmin();
    }
    match /notificationSlugs/{slug} {
      allow get: if isAccountAdmin();
      allow create: if isAccountAdmin() && request.resource.data.keys().hasAll(['id', 'slug']) && request.resource.data.keys().hasOnly(['id', 'slug'])
        && request.resource.data.id is string && request.resource.data.slug == slug
        && getAfter(notificationPath(request.resource.data.id)).data.id == request.resource.data.id
        && getAfter(notificationPath(request.resource.data.id)).data.slug == slug;
      allow delete: if isAccountAdmin() && (!existsAfter(notificationPath(resource.data.id)) || getAfter(notificationPath(resource.data.id)).data.slug != slug);
    }
    match /plans/{planId} {
      allow get: if resource.data.active == true || isOwner();
      allow list: if request.query.limit != null && request.query.limit <= 101 && (resource.data.active == true || isOwner());
      allow create: if isOwner() && planValues() && recordIdentity(planId, 'Plan')
        && planId.matches('Plan_' + string(request.resource.data.number) + '_.+_[0-9]{1,2}_[0-9]{2}_(AM|PM)_[0-9]{2}_[0-9]{2}_[0-9]{2}_[A-Za-z0-9-]+')
        && request.resource.data.created == request.time && getAfter(planCounterPath()).data.lastPlanId == planId
        && getAfter(planCounterPath()).data.number == request.resource.data.number
        && request.resource.data.number == (exists(planCounterPath()) ? get(planCounterPath()).data.number + 1 : 1);
      allow update: if isOwner() && planValues() && recordIdentity(planId, 'Plan')
        && request.resource.data.id == resource.data.id && request.resource.data.type == resource.data.type
        && request.resource.data.slug == resource.data.slug && request.resource.data.number == resource.data.number
        && request.resource.data.created == resource.data.created
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'icon', 'description', 'features', 'currency', 'priceCents', 'billingInterval', 'active', 'highlighted', 'displayOrder', 'updated']);
    }
    match /planSlugs/{slug} {
      allow get: if true;
      allow list: if request.query.limit != null && request.query.limit > 0 && request.query.limit <= 201;
      allow create: if isOwner() && planTierValues(request.resource.data, slug) && !exists(planPath(request.resource.data.id))
        && getAfter(planPath(request.resource.data.id)).data.id == request.resource.data.id
        && getAfter(planPath(request.resource.data.id)).data.type == 'Plan'
        && getAfter(planPath(request.resource.data.id)).data.slug == slug
        && getAfter(planPath(request.resource.data.id)).data.number == request.resource.data.number
        && getAfter(planPath(request.resource.data.id)).data.displayOrder == request.resource.data.displayOrder;
      allow update: if isOwner() && planTierValues(request.resource.data, slug)
        && request.resource.data.id == resource.data.id && request.resource.data.slug == resource.data.slug
        && getAfter(planPath(request.resource.data.id)).data.id == request.resource.data.id
        && getAfter(planPath(request.resource.data.id)).data.type == 'Plan'
        && getAfter(planPath(request.resource.data.id)).data.slug == slug
        && getAfter(planPath(request.resource.data.id)).data.number == request.resource.data.number
        && getAfter(planPath(request.resource.data.id)).data.displayOrder == request.resource.data.displayOrder;
    }
    match /planInterestSummary/{planId} {
      allow get: if isAccountAdmin();
      allow list: if isAccountAdmin() && request.query.limit != null && request.query.limit > 0 && request.query.limit <= 201;
      allow create: if planInterestSummaryValues(planId) && !exists(planInterestPath(request.resource.data.lastInterestId))
        && planInterestSummaryChange(planId, {});
      allow update: if planInterestSummaryValues(planId) && planInterestSummaryChange(planId, resource.data);
    }
    match /planInterestRecords/{interestId} {
      allow get: if isOwner() || (planInterestActor() && resource.data.actorKey == request.auth.uid);
      allow list: if isOwner() && request.query.limit != null && request.query.limit > 0 && request.query.limit <= 101;
      allow create: if newPlanInterest(interestId);
      allow update: if updatedPlanInterest(interestId);
    }
    match /planInterestLookup/{firebaseUid}/plans/{planId} {
      allow get: if planInterestActor() && firebaseUid == request.auth.uid;
      allow create: if newPlanInterestLookup(firebaseUid, planId);
    }
    match /planInterestLookup/{lookupId} { allow read, write: if false; }
    match /planInterestLimits/{actorId} { allow read, write: if false; }
    match /events/{eventId} {
      allow get: if isAccountAdmin();
      allow list: if isAccountAdmin() && request.query.limit != null && request.query.limit > 0 && request.query.limit <= 501;
      allow create: if isAccountAdmin() && eventValues() && recordIdentity(eventId, 'Event')
        && eventId.matches('Event_' + string(request.resource.data.number) + '_.+_[0-9]{1,2}_[0-9]{2}_(AM|PM)_[0-9]{2}_[0-9]{2}_[0-9]{2}_[A-Za-z0-9-]+')
        && request.resource.data.creatorId == actorId() && request.resource.data.created == request.time
        && getAfter(eventCounterPath()).data.lastEventId == eventId && getAfter(eventCounterPath()).data.number == request.resource.data.number
        && request.resource.data.number == (exists(eventCounterPath()) ? get(eventCounterPath()).data.number + 1 : 1);
      allow update: if isAccountAdmin() && eventValues() && recordIdentity(eventId, 'Event')
        && request.resource.data.id == resource.data.id && request.resource.data.type == resource.data.type
        && request.resource.data.number == resource.data.number && request.resource.data.creatorId == resource.data.creatorId
        && request.resource.data.created == resource.data.created
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'allDay', 'endsAt', 'updated', 'startsAt', 'location', 'description']);
      allow delete: if isAccountAdmin();
    }
    match /supportThreads/{threadId} {
      allow get: if supportReader(resource.data);
      allow list: if request.query.limit != null && request.query.limit > 0 && request.query.limit <= 41 && supportReader(resource.data);
      allow create, update, delete: if false;
      match /messages/{messageId} {
        allow get: if canReadSupportThread(threadId);
        allow list: if request.query.limit != null && request.query.limit > 0 && request.query.limit <= 51 && canReadSupportThread(threadId);
        allow create, update, delete: if false;
      }
      match /readStates/{userId} {
        allow get: if feedbackActor() && userId == actorId() && canReadSupportThread(threadId);
        allow list, create, update, delete: if false;
      }
    }
    match /feedbackEntries/{entryId} {
      allow get: if feedbackActor() && (isOwner() || resource.data.authorId == actorId());
      allow list: if isOwner() && request.query.limit != null && request.query.limit > 0 && request.query.limit <= 51;
      allow create, update, delete: if false;
    }
    match /supportThreadAccounts/{userId} { allow read, write: if false; }
    match /feedbackAttempts/{attemptId} { allow read, write: if false; }
    match /formSubmissions/{submissionId} {
      allow read: if isOwner();
      allow create: if featureEnabled('contact') && submissionValues() && recordIdentity(submissionId, 'FormSubmission')
        && submissionId.matches('FormSubmission_' + string(request.resource.data.number) + '_Contact_[0-9]{1,2}_[0-9]{2}_(AM|PM)_[0-9]{2}_[0-9]{2}_[0-9]{2}_[A-Za-z0-9-]+')
        && getAfter(submissionCounterPath()).data.lastSubmissionId == submissionId
        && getAfter(submissionCounterPath()).data.number == request.resource.data.number
        && getAfter(submissionCounterPath()).data.number == (exists(submissionCounterPath()) ? get(submissionCounterPath()).data.number + 1 : 1);
      allow update: if isOwner() && request.resource.data.status in ['new', 'read', 'archived']
        && request.resource.data.updated == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updated']);
    }
    match /users/{userId} {
      allow get: if (signedIn() && resource.data.firebase_uid == request.auth.uid) || isAccountAdmin();
      allow list: if isAccountAdmin() && request.query.limit != null && request.query.limit <= 101;
      allow create: if newIdentity() && recordIdentity(userId, 'User') && profileValues()
        && !request.resource.data.keys().hasAny(['billing', 'billingAccountId', 'subscriptionStatus', 'accessUntil', 'stripe_customer_id', 'stripe_subscription_id'])
        && request.resource.data.type == 'User' && request.resource.data.uid == request.auth.uid
        && request.resource.data.firebase_uid == request.auth.uid && request.resource.data.number == getAfter(counterPath()).data.number
        && getAfter(identityPath()).data.id == userId && request.resource.data.active == true
        && request.resource.data.role == 'Subscriber' && request.resource.data.roles == ['Subscriber']
        && request.resource.data.plan == 'free' && request.resource.data.profilePrivacy == 'private'
        && request.resource.data.publicDomains == false && request.resource.data.email == request.auth.token.email;
      allow update: if ownsAccount(userId) && profileValues()
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['name', 'description', 'profilePrivacy', 'publicDomains']) || syncedPublicProfile(userId))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name', 'updated', 'verified', 'displayName', 'description', 'lastSignIn', 'lastUpdated',
          'publicDomains', 'emailVerified', 'profilePrivacy', 'lastSignInTime'
        ]);
      allow update: if safeAccessUpdate(userId);
      match /socialFollowing/{targetId} {
        allow get: if socialActor() && ownsAccount(userId);
        allow list: if socialActor() && ownsAccount(userId) && request.query.limit != null && request.query.limit > 0 && request.query.limit <= 200;
        allow create: if socialActor() && ownsAccount(userId) && targetId != userId
          && request.resource.data.keys().hasAll(['id', 'number', 'followerId', 'followingId'])
          && request.resource.data.keys().hasOnly(['id', 'number', 'followerId', 'followingId'])
          && request.resource.data.followerId == userId && request.resource.data.followingId == targetId
          && getAfter(socialFollowPath(request.resource.data.id)).data.followerId == userId
          && getAfter(socialFollowPath(request.resource.data.id)).data.followingId == targetId
          && getAfter(socialFollowPath(request.resource.data.id)).data.number == request.resource.data.number;
        allow delete: if ownsAccount(userId) && !existsAfter(socialFollowPath(resource.data.id));
      }
      match /domains/{recordId} {
        allow read: if ownsAccount(userId);
        allow write: if false;
      }
      match /connections/{recordId} {
        allow read, delete: if ownsAccount(userId);
        allow create, update: if ownsAccount(userId) && recordIdentity(recordId, 'Connection')
          && request.resource.data.keys().hasOnly(['id', 'number', 'provider', 'values'])
          && request.resource.data.values is string
          && request.resource.data.provider in ['vercel', 'godaddy', 'hostinger', 'namecheap', 'porkbun', 'namesilo', 'squarespace']
          && (request.resource.data.provider in ['godaddy', 'hostinger'] || starterPlanAccess());
      }
      match /auctionInventory/{recordId} {
        allow read: if isOwner() && ownsAccount(userId);
        allow delete: if ownsAccount(userId);
        allow create, update: if isOwner() && ownsAccount(userId) && recordIdentity(recordId, 'Auction');
      }
      match /data/{recordId} {
        allow read, delete: if ownsAccount(userId);
        allow get: if isOwner() && resource.data.id == recordId && resource.data.uid == userId
          && resource.data.key == 'domains-database:preferences:v1';
        allow create, update: if ownsAccount(userId) && recordIdentity(recordId, 'Data') && request.resource.data.uid == userId
          && request.resource.data.key is string && request.resource.data.value is string
          && request.resource.data.revision is int && request.resource.data.revision > 0;
      }
      match /storageKeys/{keyId} {
        allow read, delete: if ownsAccount(userId);
        allow get: if isOwner() && keyId == 'domains-database%3Apreferences%3Av1';
        allow create, update: if ownsAccount(userId) && request.resource.data.keys().hasOnly(['id', 'key', 'number'])
          && request.resource.data.id is string && request.resource.data.key is string
          && request.resource.data.number is int && request.resource.data.number > 0;
      }
      match /snapshots/{snapshotId} {
        allow read: if ownsAccount(userId);
        allow delete: if ownsAccount(userId) && snapshotId != 'portfolio';
        allow get: if isOwner() && snapshotId == 'portfolio';
        allow create, update: if ownsAccount(userId) && snapshotId in ['storage', 'connections', 'auctionInventory']
          && (snapshotId != 'auctionInventory' || isOwner());
        allow update: if ownsAccount(userId) && snapshotId == 'auctionInventory' && emptyAuctionSnapshotReset();
      }
    }
    match /billingUsers/{userId} {
      allow get: if ownsAccount(userId);
      allow list, write: if false;
    }
    match /portfolioUsage/{userId} {
      allow read, write: if false;
    }
    match /{path=**}/domains/{recordId} {
      allow get: if isAccountAdmin();
      allow list: if isAccountAdmin() && request.query.limit != null && request.query.limit <= 501;
    }
  }
}
